[Unit]
Description=JurisFlow Municipal POC
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=poctui
Group=poctui
WorkingDirectory=/opt/poc-tuitecnologia/current
EnvironmentFile=/etc/poc-tuitecnologia.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/poc-tuitecnologia
CapabilityBoundingSet=
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
