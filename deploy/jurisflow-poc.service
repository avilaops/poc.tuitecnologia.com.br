[Unit]
Description=JurisFlow Municipal POC
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=jurisflow
Group=jurisflow
WorkingDirectory=/opt/jurisflow-poc/current
EnvironmentFile=/etc/jurisflow-poc.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jurisflow-poc
CapabilityBoundingSet=
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
